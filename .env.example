# ---- app ------------------------------------------------------------
VA_ENV=local
VA_LOG_LEVEL=INFO
VA_DRY_RUN=true                 # true = never push a branch or write to JIRA

# ---- database ---------------------------------------------------------
VA_DATABASE_URL=postgresql+asyncpg://vulnagent:vulnagent@localhost:5432/vulnagent

# ---- JIRA -------------------------------------------------------------
VA_JIRA_BASE_URL=https://yourco.atlassian.net
VA_JIRA_EMAIL=svc-vulnagent@yourco.com
VA_JIRA_API_TOKEN=
# Adjust to however your scanner marks a ticket as ready for automated fixing.
VA_JIRA_POLL_JQL=project = SEC AND status = "To Do" AND labels = auto-remediate
VA_JIRA_TRANSITION_DONE=In Review
VA_JIRA_TRANSITION_ESCALATED=Needs Manual Fix

# ---- GitHub ---------------------------------------------------------------
# Option A (personal repo): a fine-grained PAT with Contents + Pull requests
# read/write on the target repo. Blank is fine for cloning a public repo.
VA_GITHUB_TOKEN=
# VA_GITHUB_DEFAULT_ORG=your-github-username   # only if tickets give bare repo names
# Option B (org): a GitHub App instead of a PAT.
VA_GITHUB_APP_ID=
VA_GITHUB_INSTALLATION_ID=
VA_GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.pem

# ---- model --------------------------------------------------------------
VA_LLM_PROVIDER=anthropic        # anthropic | bedrock
VA_LLM_MODEL_PATCHER=claude-sonnet-4-6
ANTHROPIC_API_KEY=
AWS_REGION=us-east-1

# ---- observability ------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- budgets / safety -----------------------------------------------------
VA_MAX_FIX_ATTEMPTS=3
VA_DAILY_TOKEN_BUDGET=500000
VA_KILL_SWITCH=false
